{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "packages": {
    "apps/web": {
      "component": "web",
      "extra-files": [
        "package.json"
      ]
    },
    "services/api": {
      "component": "api",
      "extra-files": [
        "package.json",
        "src/version.ts"
      ]
    },
    "packages/contracts": {
      "component": "contracts",
      "extra-files": [
        "package.json"
      ]
    }
  }
}
