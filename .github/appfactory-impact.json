{
  "version": 1,
  "fallback": "all",
  "ignorePaths": [
    "README.md",
    "PASSATION.md",
    "AGENTS.md",
    "docs/**",
    ".github/project-config.json",
    ".github/workflows/project-automation.yml"
  ],
  "surfaces": {
    "contracts": {
      "paths": ["packages/contracts/**"],
      "gates": ["contracts"]
    },
    "api": {
      "paths": ["services/api/**"],
      "gates": ["api"],
      "dependsOn": ["contracts"]
    },
    "web": {
      "paths": ["apps/web/**"],
      "gates": ["web", "visual-qa"],
      "dependsOn": ["contracts"]
    },
    "mobile": {
      "paths": ["apps/mobile/**"],
      "gates": ["mobile-android", "mobile-ios"],
      "dependsOn": ["contracts"]
    },
    "workspace": {
      "paths": ["package.json", "package-lock.json"],
      "gates": ["web", "api", "contracts"]
    },
    "release": {
      "paths": [
        ".release-please-manifest.json",
        "release-please-config.json",
        ".github/workflows/release.yml",
        "apps/mobile/androidApp/build.gradle.kts"
      ],
      "gates": ["release-config"]
    },
    "ci": {
      "paths": [".github/appfactory-impact.json", ".github/appfactory-visual-qa.json", ".github/workflows/ci.yml"],
      "gates": ["web", "visual-qa", "api", "contracts", "mobile-android", "mobile-ios"]
    }
  }
}
