{
  "version": 1,
  "fallback": "all",
  "ignorePaths": [
    "README.md",
    "PASSATION.md",
    "AGENTS.md",
    "docs/**",
    ".github/project-config.json",
    ".github/workflows/project-automation.yml"
  ],
  "surfaces": {
    "contracts": {
      "paths": ["packages/contracts/**"],
      "gates": ["contracts"]
    },
    "api": {
      "paths": ["services/api/**"],
      "gates": ["api"],
      "dependsOn": ["contracts"]
    },
    "web": {
      "paths": ["apps/web/**"],
      "gates": ["web"],
      "dependsOn": ["contracts"]
    },
    "workspace": {
      "paths": ["package.json", "package-lock.json"],
      "gates": ["web", "api", "contracts"]
    },
    "release": {
      "paths": [
        ".release-please-manifest.json",
        "release-please-config.json",
        ".github/workflows/release.yml"
      ],
      "gates": ["release-config"]
    },
    "ci": {
      "paths": [".github/appfactory-impact.json", ".github/workflows/ci.yml"],
      "gates": ["web", "api", "contracts"]
    }
  }
}
