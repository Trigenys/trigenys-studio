{
  "openapi": "3.1.0",
  "info": {
    "title": "Trigenys Studio API",
    "version": "0.1.0",
    "description": "Cockpit de production et de communication Trigenys."
  },
  "tags": [
    {
      "name": "system",
      "description": "État du service"
    }
  ],
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "title",
          "status"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable",
              "unconfigured",
              "unchecked"
            ]
          },
          "integrations": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "mock",
                "live"
              ]
            }
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "time",
          "database",
          "integrations"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness and readiness of the API",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "When true, also checks the database connection"
            },
            "required": false,
            "description": "When true, also checks the database connection",
            "name": "deep",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Service state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
