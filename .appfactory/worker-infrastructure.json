{
  "schemaVersion": 1,
  "provider": "cloudflare-workers-builds",
  "repository": "Trigenys/trigenys-studio",
  "workerName": "trigenys-studio-api",
  "runtime": "typescript-wrangler",
  "rootDirectory": "/services/api",
  "buildCommand": "npm install --ignore-scripts --no-audit --no-fund && npm run check",
  "deployCommand": "npm exec --no -- wrangler deploy --config wrangler.production.jsonc --keep-vars"
}
