{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production config, deployed only by the AppFactory Workers Builds trigger
  // (.appfactory/worker.json, recipe typescript-wrangler at /services/api).
  // Local development uses wrangler.jsonc.
  "name": "trigenys-studio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: Notify is another workers.dev Worker of the same
  // account; without it a plain fetch to it gets 404 (Cloudflare error 1042).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // The web app (apps/web, built by `npm run check`) is served by this Worker,
  // same origin as the API (ADR 0016). Hashed files are served directly; every
  // other request runs the Worker, which sends page loads to ASSETS (index.html
  // fallback) and everything else to the API.
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"]
  },
  // Non-secret configuration only. Secrets: TRIGENYS_STUDIO_AUTH_SECRET is
  // generated by AppFactory; integration keys are Worker secrets. Deployed with
  // --keep-vars, so these values are the source of truth for the vars below.
  // Integrations start in mock mode and are switched to live one by one.
  "vars": {
    "SERVICE_NAME": "trigenys-studio-api",
    "INTEGRATION_PUBLISHER_MODE": "mock",
    "BUFFER_BASE_URL": "https://api.buffer.com",
    "PUBLISH_LEAD_MINUTES": "10",
    "INTEGRATION_CMS_MODE": "mock",
    "INTEGRATION_RADAR_MODE": "mock",
    "INTEGRATION_METRICS_MODE": "mock",
    "METRICS_BASE_URL": "",
    "METRICS_REFRESH_MINUTES": "360",
    "METRICS_BATCH": "25",
    "ALERT_APPROVAL_HOURS": "24",
    "ALERT_STALL_HOURS": "72",
    "ALERT_DUE_SOON_HOURS": "24",
    "INTEGRATION_LLM_MODE": "mock",
    "INTEGRATION_EMAIL_MODE": "live",
    "NOTIFY_EMAIL_BASE_URL": "https://trigenys-notify-staging-api.lawrynnjennifer.workers.dev",
    "NOTIFY_PROJECT": "trigenys-studio",
    "WHATSAPP_NOTIFY_EVENTS": "task_assigned",
    "INTEGRATION_WHATSAPP_MODE": "live",
    "NOTIFY_WHATSAPP_BASE_URL": "",
    // Logos and rendered files must outlive requests and Worker restarts.
    "INTEGRATION_MEDIA_MODE": "live",
    "AUTH_BASE_URL": "https://trigenys-studio-api.lawrynnjennifer.workers.dev",
    // Web app origin(s), comma-separated; empty until the web app is deployed.
    "AUTH_TRUSTED_ORIGINS": "https://trigenys-studio-api.lawrynnjennifer.workers.dev",
    "WEB_APP_URL": "https://trigenys-studio-api.lawrynnjennifer.workers.dev",
    "PASSKEY_RP_NAME": "Trigenys Studio",
    // MCP over OAuth 2.1: tokens issued by Trigenys Auth for this resource,
    // client "trigenys-studio" (public, PKCE), members of the listed orgs only.
    "OIDC_ISSUER": "https://auth.trigenys.com",
    "OIDC_RESOURCE": "https://trigenys-studio-api.lawrynnjennifer.workers.dev/mcp",
    "OIDC_ORGS": "trigenys",
    "OIDC_APP": "trigenys-studio"
  },
  // AppFactory replaces this placeholder (exactly once) with the managed
  // Hyperdrive id in a temporary copy at deploy time; the file is never rewritten.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "appfactory-managed-hyperdrive" }
  ],
  // Created privately by AppFactory's private-media recipe before release.
  // Files are served only by the API after session and product authorization.
  "r2_buckets": [
    { "binding": "VISUALS", "bucket_name": "trigenys-studio-media" }
  ]
}
