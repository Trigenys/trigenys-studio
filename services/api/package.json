{
  "name": "@trigenys/studio-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=dot",
    "build": "wrangler deploy --dry-run --outdir dist",
    "openapi:export": "node scripts/export-openapi.ts",
    "openapi:check": "node scripts/export-openapi.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.17",
    "@better-auth/passkey": "^1.7.18",
    "@hono/zod-openapi": "^1.6.3",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.8.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
