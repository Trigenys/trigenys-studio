{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name follows the AppFactory Neon convention: <repo>-api.
  "name": "trigenys-studio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Publishing outbox: hands due deliveries to the provider and polls their status.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // Non-secret configuration only. The Neon URI is injected by AppFactory as a
  // Worker secret and reaches the Worker through the Hyperdrive binding.
  "vars": {
    "SERVICE_NAME": "trigenys-studio-api",
    "INTEGRATION_PUBLISHER_MODE": "mock",
    // live: BUFFER_API_KEY secret (wrangler secret put BUFFER_API_KEY); BUFFER_BASE_URL and
    // BUFFER_ORGANIZATION_ID optional vars. PUBLISH_LEAD_MINUTES: how early a delivery is handed off.
    "BUFFER_BASE_URL": "https://api.buffer.com",
    "PUBLISH_LEAD_MINUTES": "10",
    // live: INSIGHT_BASE_URL var + INSIGHT_PUBLISHING_TOKEN secret (wrangler secret put).
    "INTEGRATION_CMS_MODE": "mock",
    // live: EDITORIAL_OS_BASE_URL var + EDITORIAL_OS_TOKEN secret.
    "INTEGRATION_RADAR_MODE": "mock",
    // live: METRICS_BASE_URL var + METRICS_TOKEN secret (wrangler secret put METRICS_TOKEN), generic
    // HTTP JSON contract (ADR 0010). METRICS_REFRESH_MINUTES / METRICS_BATCH tune the cron refresh.
    "INTEGRATION_METRICS_MODE": "mock",
    "METRICS_BASE_URL": "",
    "METRICS_REFRESH_MINUTES": "360",
    "METRICS_BATCH": "25",
    // Alerts (ADR 0011): thresholds in hours; WEB_APP_URL is the base of the links in alert e-mails
    // (defaults to the first AUTH_TRUSTED_ORIGINS entry).
    "ALERT_APPROVAL_HOURS": "24",
    "ALERT_STALL_HOURS": "72",
    "ALERT_DUE_SOON_HOURS": "24",
    // "live" needs the ANTHROPIC_API_KEY Worker secret (wrangler secret put ANTHROPIC_API_KEY);
    // LLM_MODEL (optional var) overrides the default model of the adapter.
    "INTEGRATION_LLM_MODE": "mock",
    // live: Trigenys Notify (ADR 0013), NOTIFY_EMAIL_BASE_URL var + NOTIFY_EMAIL_INGEST_KEY secret
    // (wrangler secret put NOTIFY_EMAIL_INGEST_KEY); NOTIFY_PROJECT is the Notify project id.
    "INTEGRATION_EMAIL_MODE": "mock",
    "NOTIFY_EMAIL_BASE_URL": "",
    "NOTIFY_PROJECT": "trigenys-studio",
    // live: objects go to the private VISUALS bucket below (memory otherwise, not durable).
    "INTEGRATION_MEDIA_MODE": "mock",
    // Better Auth. AUTH_SECRET is a Worker secret (wrangler secret put AUTH_SECRET).
    "AUTH_BASE_URL": "http://localhost:8787",
    "AUTH_TRUSTED_ORIGINS": "http://localhost:5173",
    "PASSKEY_RP_NAME": "Trigenys Studio"
  },
  // The Hyperdrive id is provisioned by AppFactory (contribution U1, appfactory#185).
  // Locally, set WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a dev branch URI.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }
  ],
  // Logos and rendered visuals, never public: served by the API after RBAC.
  "r2_buckets": [
    { "binding": "VISUALS", "bucket_name": "trigenys-studio-visuals" }
  ]
}
